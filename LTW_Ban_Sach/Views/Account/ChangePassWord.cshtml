@model LTW_Ban_Sach.ViewModel.ChangePassword
@{
    ViewBag.Title = "ChangePassWord";
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
}

<div style="margin-top: 50px; margin-bottom: 20px;" class="p-3">
    <div class="container-fluid d-flex justify-content-between">
        <div class="" style="width: 50px;">
            <a style="line-height: 100px;" href="javascript:history.back()"><i class="fa-solid fa-arrow-left" style="font-size: 25px;color: rgb(10,25,47); line-height: 30px;"></i></a>
        </div>
        <div style="width: calc(100% - 50px)">
            <hr />
            <div class="container"><h3>Change Pasword</h3></div>
            <hr />
        </div>

    </div>
</div>
<div class="container">
    @using (Html.BeginForm("ChangePassword", "Account", FormMethod.Post))
    {
        <input type="hidden" name="userId" value="@ViewBag.UserId" />
        <div class="" style="padding: 20px; background-color: aliceblue; border-radius: 10px; margin-bottom: 50px;">
            <table class="table" style="border-radius: 10px;">
                <tr>
                    <td colspan="2">
                        <div>
                            @Html.LabelFor(r => r.PasswordOld, "Old Password: ", new { @style = "font-weight: 500" })
                            @Html.PasswordFor(r => r.PasswordOld, new { @class = "form-control" })
                            @Html.ValidationMessageFor(r => r.PasswordOld, "", new { @class = "text-danger", @style = "font-size: 12px;" })
                        </div>
                    </td>
                    
                </tr>
                <tr>
                    <td>
                        <div>
                            @Html.LabelFor(r => r.ConfirmPassword, "Confirm Password: ", new { @style = "font-weight: 500" })
                            @Html.PasswordFor(r => r.ConfirmPassword, new { @class = "form-control" })
                            @Html.ValidationMessageFor(r => r.ConfirmPassword, "", new { @class = "text-danger", @style = "font-size: 12px;" })
                        </div>
                    </td>
                    <td>
                        <div>
                            @Html.LabelFor(r => r.PasswordNew, "New Password: ", new { @style = "font-weight: 500" })
                            @Html.PasswordFor(r => r.PasswordNew, new { @class = "form-control" })
                            @Html.ValidationMessageFor(r => r.PasswordNew, "", new { @class = "text-danger", @style = "font-size: 12px;" })
                        </div>
                    </td>
                </tr>
            </table>
            <div class="d-flex justify-content-center">
                <button type="submit" class="btn btn-primary">Update</button>
            </div>
        </div>

    }

</div>


