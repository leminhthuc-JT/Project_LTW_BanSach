@model LTW_Ban_Sach.Identity.AppUser
@{
    ViewBag.Title = "ProFile";
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
}
<div style="margin-top: 80px; margin-bottom: 20px;" class="p-3">

    <div class="container">
        <div class="row mb-5" style="border-top: 1px solid rgb(10,25,47); border-bottom: 1px solid rgb(10,25,47); padding: 10px;">
            <div class="col-2">
                <a href="/Home/Index"><i class="fa-solid fa-arrow-left" style="font-size: 25px;color: rgb(10,25,47); line-height: 30px;"></i></a>
            </div>
            <div class="col-10" style="padding-left: 200px;">
                <h2 style="font-size: 40px; line-height:30px; color: rgba(10,25,47, 0.9)">My Profile</h2>
            </div>
        </div>
    </div>

    <div class="container">

        <div>
            <div class="col-2" style="width: 200px; height:200px; border-radius: 100px; background: url('/Content/Image/@Model.Avatar'); background-size: cover; float: left"></div>
            <div>
                <button type="button" class="btn btn-secondary DeleteCart">Change</button>
            </div>
        </div>
        <div class="col-10 mt-5 mb-5" style="padding-left: 200px; float: right; width: calc(100% - 200px)">
            <p><strong>Username:</strong> @Model.UserName</p>
            <p><strong>Email:</strong> @Model.Email</p>
            <p><strong>Phone Number:</strong> @Model.PhoneNumber</p>
            <p><strong>Address:</strong> @Model.Address</p>
        </div>
        <div class="d-flex" style="clear: both">
            <div class="me-3"><a href="/Account/EditProfile?userId=@Model.Id" class="btn" id="LogOutButton" style="background-color: rgba(80, 193, 120, 0.4);  width: 200px;" onclick="LogOut">Change Information</a></div>
            <div class="me-3"><a href="/Account/ChangePassword?userId=@Model.Id" class="btn" id="LogOutButton" style="background-color: rgba(80, 193, 120, 0.4);  width: 200px;" onclick="LogOut">Change Password</a></div>
            <div class="me-3"><a class="btn" id="LogOutButton" style="background-color: rgba(80, 193, 120, 0.4);  width: 200px; " onclick="LogOut" href="/Account/Logout">Log out</a></div>
        </div>

    </div>


</div>
<div id="modalOverlay"
     style="display:none; position:fixed; top:0; left:0; width:100%; height:100%;
        background:rgba(0,0,0,0.4); z-index:9999; justify-content:center; align-items:center;">
    <div id="modalDelete" class="" style="padding-top: 50px; width: 400px; height: 250px; background-color: white; border-radius: 10px; box-shadow: 0 6px 10px rgba(0, 0, 0, 0.4); text-align: center;
                                          position: absolute; top: 50%; left: 50%; transform:translate(-50%, -50%);">
        <div style=""><i style="font-size: 70px; color: #808080;" class="fa-solid fa-xmark"></i></div>
        <div>
            <form>
                <label for="changeImage">Chọn ảnh đại diện</label>
                <input type="file" id="changeImage" name="changeImage" class="form-control" />
                <div class="d-flex justify-content-center mt-4">
                    <a href="/Account/Profile?userId=@Model.Id" style="text-decoration: none; color: white; text-align: center ">
                        <div class="bg-secondary" style="width: 150px; line-height: 40px; margin: 20px 5px; border-radius: 5px;">
                            Cancel
                        </div>
                    </a>
                    <button type="submit" formaction="/Account/changeImageAvatar" formmethod="get" id="dataLink" style="text-decoration: none; color: white; text-align: center ">
                        <div class="bg-danger" style="width: 150px; line-height: 40px; margin: 20px 5px; border-radius: 5px;">
                            Change
                        </div>
                    </button>
                </div>
            </form>
            
        </div>
    </div>
</div>
<script>
    document.querySelectorAll('.DeleteCart').forEach(btn => {
    btn.addEventListener('click', () => {

        document.getElementById('modalOverlay').style.display = "block";
    });
});
document.getElementById('modalOverlay').addEventListener('click', (e) => {
    if (e.target === e.currentTarget) {
        e.currentTarget.style.display = "none";
    }
})
</script>